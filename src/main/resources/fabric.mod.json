{
	"schemaVersion": 1,
	"id": "orbitclient",
	"version": "${version}",
	"name": "Orbit Client",
	"description": "A PvP client mod with a Lunar-style mod menu, HUD editor and quality-of-life mods.",
	"authors": ["EyeSaber"],
	"license": "MIT",
	"icon": "assets/orbitclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.orbitclient.OrbitClient"]
	},
	"mixins": ["orbitclient.mixins.json"],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	}
}
